 #ifdef CONFIG_AIRPLAY_2
+/* Canonicalise an address and append it once. NQPTP matches inet_ntop text,
+ * so a client list that mixes IPv4 and IPv6 must use that spelling. */
+static void append_timing_peer(char *message, size_t message_size, const char *raw) {
+  struct addrinfo hints, *res = NULL;
+  char canon[INET6_ADDRSTRLEN];
+  char token[INET6_ADDRSTRLEN + 3];
+  char padded[4096];
+  void *addr = NULL;
+
+  if ((raw == NULL) || (raw[0] == '\0'))
+    return;
+  memset(&hints, 0, sizeof(hints));
+  hints.ai_family = AF_UNSPEC;
+  hints.ai_flags = AI_NUMERICHOST;
+  if ((getaddrinfo(raw, NULL, &hints, &res) != 0) || (res == NULL))
+    return;
+  if (res->ai_family == AF_INET)
+    addr = &((struct sockaddr_in *)res->ai_addr)->sin_addr;
+  else if (res->ai_family == AF_INET6)
+    addr = &((struct sockaddr_in6 *)res->ai_addr)->sin6_addr;
+  else {
+    freeaddrinfo(res);
+    return;
+  }
+  if (inet_ntop(res->ai_family, addr, canon, sizeof(canon)) == NULL) {
+    freeaddrinfo(res);
+    return;
+  }
+  freeaddrinfo(res);
+  snprintf(token, sizeof(token), " %s ", canon);
+  snprintf(padded, sizeof(padded), " %s ", message);
+  if (strstr(padded, token) != NULL)
+    return;
+  strncat(message, " ", message_size - 1 - strlen(message));
+  strncat(message, canon, message_size - 1 - strlen(message));
+}
